# Copie ce fichier en .ftp.env et remplis tes identifiants.
# .ftp.env est gitignoré : il ne sera jamais committé.

# Chez Free.fr : host = ftpperso.free.fr, identifiants = ceux de ton compte Free.
FTP_HOST="ftpperso.free.fr"
FTP_USER="ton-login-free"
FTP_PASS="ton-mot-de-passe-ftp"

# Racine web sur le serveur. Chez Free.fr, c'est la racine FTP : "/"
FTP_DIR="/"
